@@ -116,11 +117,18 @@
 function simple_image_rotate_widget_process($element, FormStateInterface $form_state) {
 
   if (isset($element['#files']) && count($element['#files']) > 0) {
+    // Preserve the previously submitted rotation instead of always
+    // resetting it to 0, otherwise a rotated image reverts to its
+    // original orientation when another image is added to the field.
+    $data = NestedArray::getValue($form_state->getValues(), $element['#parents']);
+    $degrees = !empty($data['rotate']) ? $data['rotate'] : 0;
+
     $element['rotate_button'] = [
       '#markup' => Markup::create(sprintf('<button class="button button--secondary rotate-icon">%s</button>', t('Rotate image clockwise'))),
       '#weight' => $element['#weight'],
       '#theme_wrappers' => ['container']
     ];
+    $element['rotate']['#value'] = $degrees;
   }
   return $element;
 }
