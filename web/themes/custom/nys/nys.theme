<?php

/**
 * @file
 * Functions to support theming in the NY Senate theme.
 */

declare(strict_types=1);

use Drupal\Component\Utility\Html;
use Drupal\Core\Link;
use Drupal\Core\Template\Attribute;
use Drupal\Core\Url;
use Drupal\nys_users\UsersHelper;

/**
 * Implements hook_theme_suggestions_page_alter().
 */
function nys_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  // Add page suggestions based on the current page route.
  $route_name = \Drupal::routeMatch()->getRouteName();
  $route_name = str_replace('-', '_', $route_name);
  $route_name = str_replace('.', '__', $route_name);
  $suggestions[] = "page__route__{$route_name}";

  // Add vocabulary-specific suggestions for taxonomy term pages.
  $term = \Drupal::routeMatch()->getParameter('taxonomy_term');
  if ($term instanceof \Drupal\taxonomy\TermInterface) {
    $suggestions[] = 'page__taxonomy__term__' . $term->bundle();
  }
}

/**
 * Implements hook_page_attachments_alter().
 */
function nys_page_attachments_alter(array &$attachments) {
  $current_path = \Drupal::service('path.current')->getPath();
  if (str_starts_with($current_path, '/senator-dashboard/')) {
    $attachments['#attached']['library'][] = 'nys/senator-dashboard-global';
  }
}

/**
 * Implements hook_preprocess_taxonomy_term__TAXONOMY().
 *
 * Provides the "contact your senator" sidebar card and follower count for
 * the /global-issues/[term] page (taxonomy-term--global-issues.html.twig),
 * mirroring what nysenate_theme_preprocess_taxonomy_term__issues() builds
 * for the existing /issues page - kept separate and minimal here rather
 * than reusing that function, since it also builds several other
 * view-variable blocks this template doesn't use.
 */
function nys_preprocess_taxonomy_term__global_issues(&$variables) {
  $user = \Drupal::entityTypeManager()->getStorage('user')
    ->load(\Drupal::currentUser()->id());

  $senator_name = '';
  $senator_link = NULL;
  $senator_image = NULL;
  $senator = UsersHelper::getSenator($user);
  $variables['senator'] = $senator;

  if (!empty($senator)) {
    if (isset($senator->name->value) && !empty($senator->name->value)) {
      $senator_name = $senator->name->value;
    }
    $senator_link = \Drupal::service('nys_senators.microsites')->getMicrosite($senator);
    if ($senator->hasField('field_member_headshot') && !$senator->get('field_member_headshot')->isEmpty()) {
      $headshot_id = $senator->field_member_headshot->target_id;
      $headshot = \Drupal::entityTypeManager()->getStorage('media')->load($headshot_id);
      $senator_image = \Drupal::entityTypeManager()->getViewBuilder('media')->view($headshot, 'thumbnail');
    }
  }

  $title = '';
  $link = [];
  if (\Drupal::currentUser()->isAuthenticated()) {
    $is_out_of_state = \Drupal::service('nys_users.user_helper')->isOutOfState($user);
    if ($is_out_of_state) {
      $title = t('Contact the Senate about this issue');
      $link = [
        'url' => '/form/contact',
        'text' => t('Contact Senate'),
      ];
    }
    else {
      $title = t('Contact your Senator about this issue');
      $link = [
        'url' => $senator_link . '/contact',
        'text' => t('Contact') . ' ' . $senator_name,
      ];
    }
  }
  else {
    $current_path = \Drupal::service('path.current')->getPath();
    $path_alias = \Drupal::service('path_alias.manager')->getAliasByPath($current_path);
    $link = Link::fromTextAndUrl(
      t('Find your Senator'),
      Url::fromUserInput('/user/login', ['query' => ['destination' => $path_alias]])
    );
  }

  $variables['contact_your_senator'] = [
    'logged_in' => \Drupal::currentUser()->isAuthenticated(),
    'title' => $title,
    'senator_image' => $senator_image,
    'link' => $link,
  ];

  $flag_service = \Drupal::service('flag.count');
  $flag = $flag_service->getEntityFlagCounts($variables['term']);
  if ($flag) {
    $variables['flag_count'] = $flag['follow_global_issue'] ?? NULL;
  }

  $variables['hero_stats'] = nys_global_issue_hero_stats((int) $variables['term']->id());

  $variables['related_issue_bills'] = [];
  if ($variables['term']->hasField('field_related_issue') && !$variables['term']->get('field_related_issue')->isEmpty()) {
    foreach ($variables['term']->get('field_related_issue')->referencedEntities() as $related_term) {
      $variables['related_issue_bills'][] = [
        'name' => $related_term->label(),
        'count' => nys_global_issue_bill_count((int) $related_term->id()),
        'url' => nys_global_issue_search_url((int) $related_term->id()),
      ];
    }
  }

  $variables['all_bills_url'] = nys_global_issue_search_url((int) $variables['term']->id());

  $variables['#cache']['tags'][] = 'taxonomy_term_list:global_issues';
  $variables['#cache']['tags'][] = 'node_list:bill';
}

/**
 * Builds the /search/legislation URL for a global_issues term's bills.
 *
 * Shared by the "Related Issues" sidebar box (per related term) and the
 * "See all related bills" link on the Featured Legislation header (for
 * the current term) - same session/issue/status/sponsor/committee query
 * shape either way.
 *
 * @param int $term_id
 *   The global_issues taxonomy term ID.
 *
 * @return string
 *   The search URL.
 */
function nys_global_issue_search_url(int $term_id): string {
  return Url::fromUserInput('/search/legislation', [
    'query' => [
      'type' => 'bill',
      'session_year' => 2025,
      'issue' => $term_id,
      'status' => 'all',
      'sponsor' => 'all',
      'committee' => 'all',
    ],
  ])->toString();
}

/**
 * Counts published, current-session bills tagged with a global_issues term.
 *
 * Used by the "Related Issues" sidebar box on the /global-issues page,
 * which needs just the bill count (not the sponsor/passed-senate counts
 * nys_global_issue_hero_stats() also computes) for each of the current
 * term's related issues. This isn't a materialized/cached number - it's a
 * live count on every render, invalidated by the node_list:bill cache tag
 * whenever a bill is saved, so there's no separate process needed to keep
 * it "up to date."
 *
 * @param int $term_id
 *   The global_issues taxonomy term ID.
 *
 * @return int
 *   The bill count.
 */
function nys_global_issue_bill_count(int $term_id): int {
  return (int) \Drupal::entityQuery('node')
    ->accessCheck(FALSE)
    ->condition('type', 'bill')
    ->condition('status', 1)
    ->condition('field_ol_session', 2025)
    ->condition('field_global_issues', $term_id)
    ->count()
    ->execute();
}

/**
 * Builds the real bill counts shown in the /global-issues hero stats row.
 *
 * All three counts share the same base scope: published bills in the
 * 2025 session tagged with this global_issues term. "Sponsored Bills"
 * and "Senators Sponsoring" deliberately don't filter by current status -
 * they cover every bill sponsored on this issue this session, not just
 * ones still actively moving. Numbers/labels here are a first pass, not
 * final - expect them to change once stakeholders weigh in.
 *
 * @param int $term_id
 *   The global_issues taxonomy term ID.
 *
 * @return array
 *   Keys: bill_count, sponsor_count, passed_senate_count - all int.
 */
function nys_global_issue_hero_stats(int $term_id): array {
  $base_query = \Drupal::entityQuery('node')
    ->accessCheck(FALSE)
    ->condition('type', 'bill')
    ->condition('status', 1)
    ->condition('field_ol_session', 2025)
    ->condition('field_global_issues', $term_id);

  $bill_nids = $base_query->execute();

  $sponsor_count = 0;
  if ($bill_nids) {
    $sponsor_query = \Drupal::database()->select('node__field_ol_sponsor', 'fs')
      ->condition('fs.entity_id', $bill_nids, 'IN');
    $sponsor_query->addExpression('COUNT(DISTINCT fs.field_ol_sponsor_target_id)');
    $sponsor_count = (int) $sponsor_query->execute()->fetchField();
  }

  $passed_senate_count = 0;
  if ($bill_nids) {
    $passed_senate_count = (int) \Drupal::entityQuery('node')
      ->accessCheck(FALSE)
      ->condition('type', 'bill')
      ->condition('status', 1)
      ->condition('field_ol_session', 2025)
      ->condition('field_global_issues', $term_id)
      ->condition('field_passed_senate_current', 1)
      ->count()
      ->execute();
  }

  return [
    'bill_count' => count($bill_nids),
    'sponsor_count' => $sponsor_count,
    'passed_senate_count' => $passed_senate_count,
  ];
}

/**
 * Implements hook_preprocess_page().
 */
function nys_preprocess_page(&$variables) {
  $current_path = \Drupal::service('path.current')->getPath();
  if (str_starts_with($current_path, '/senator-dashboard/')) {
    $variables['actionbar']['type'] = 'disabled';
  }
}

/**
 * Implements hook_preprocess_node().
 */
function nys_preprocess_node(&$variables) {
  if ($variables['node']->getType() == 'bill' && $variables['view_mode'] == 'senator_dashboard_bill_teaser') {
    $variables['#attached']['library'][] = 'nys/senator-dashboard-bill-teaser';
  }
}

/**
 * Implements hook_preprocess_views_view_fields().
 */
function nys_preprocess_views_view_fields(&$variables) {
  $view = $variables['view'];

  // Maps each view/display that shows a grouped, multi-party-aware
  // senator card to the raw sponsor/senator target-id field it exposes -
  // field_party is aggregated (grouped) in all of these, and a
  // fusion-endorsed senator's multiple party values would otherwise fan
  // out into duplicate rows, so each display is filtered to just the
  // first (delta 0) to avoid that. Re-loading the senator fresh by their
  // raw tid sidesteps that SQL-level restriction entirely, to show every
  // party they hold.
  $target_id_fields = [
    'featured_legislative_issues' => [
      'active_senators' => 'field_ol_sponsor_target_id',
    ],
    'news_by_issue' => [
      'senators_mentioned' => 'field_senator_multiref_target_id',
    ],
  ];
  $target_id_field = $target_id_fields[$view->id()][$view->current_display] ?? NULL;
  if ($target_id_field === NULL) {
    return;
  }

  $variables['senator_parties'] = [];
  if (isset($variables['fields'][$target_id_field])) {
    $tid = (int) trim(strip_tags((string) $variables['fields'][$target_id_field]->content));
    $term = $tid ? \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load($tid) : NULL;
    if ($term && $term->hasField('field_party') && !$term->get('field_party')->isEmpty()) {
      foreach ($term->get('field_party')->getValue() as $item) {
        $variables['senator_parties'][] = $item['value'];
      }
    }
  }
}

/**
 * Implements hook_preprocess_taxonomy_term__TAXONOMY().
 *
 * Provides the pre-formatted district and party strings for the compact
 * news-byline view mode (taxonomy-term--senator--news-byline.html.twig),
 * used on the issues page's Recent News cards. District isn't a direct
 * field on the senator term - it lives on the separate "districts"
 * vocabulary, which references back to the senator via field_senator, so
 * it has to be resolved with a reverse lookup rather than a plain field
 * formatter (same reason field_district_number is pulled via a Views
 * relationship elsewhere on this page, not a formatter). Party uses the
 * same raw-abbreviation-values approach as
 * nys_preprocess_views_view_fields()'s senator_parties (e.g. "D", "WF"
 * for a fusion-endorsed senator), joined here since this view mode has no
 * views row to attach a separate field to.
 */
function nys_preprocess_taxonomy_term__senator(&$variables) {
  if (($variables['elements']['#view_mode'] ?? NULL) !== 'news_byline') {
    return;
  }

  $variables['party'] = '';
  if ($variables['term']->hasField('field_party') && !$variables['term']->get('field_party')->isEmpty()) {
    $parties = array_map(static fn (array $item) => $item['value'], $variables['term']->get('field_party')->getValue());
    $variables['party'] = implode(', ', $parties);
  }

  $variables['district'] = '';
  $districts = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadByProperties([
    'vid' => 'districts',
    'field_senator' => $variables['term']->id(),
  ]);
  $district_term = $districts ? reset($districts) : NULL;
  if (!$district_term || !$district_term->hasField('field_district_number') || $district_term->get('field_district_number')->isEmpty()) {
    return;
  }

  $number = (int) $district_term->get('field_district_number')->value;
  $last_two = $number % 100;
  $last_one = $number % 10;
  if ($last_two >= 11 && $last_two <= 13) {
    $suffix = 'th';
  }
  else {
    $suffix = match ($last_one) {
      1 => 'st',
      2 => 'nd',
      3 => 'rd',
      default => 'th',
    };
  }

  $variables['district'] = $number . $suffix . ' Senate District';
}
