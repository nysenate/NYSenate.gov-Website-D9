{#
/**
 * @file
 * Single senator row for the "Senators active on this issue" sidebar
 * block (featured_legislative_issues:active_senators). One row per
 * distinct sponsor, aggregated (grouped) by the view.
 *
 * @see components/02-components/senator-active-card
 */
#}
{% set district_num = fields.field_district_number.content|render|striptags|trim %}
{% set district_text = '' %}
{% if district_num %}
  {% set last_two = district_num % 100 %}
  {% set last_one = district_num % 10 %}
  {% if last_two >= 11 and last_two <= 13 %}
    {% set ordinal_suffix = 'th' %}
  {% elseif last_one == 1 %}
    {% set ordinal_suffix = 'st' %}
  {% elseif last_one == 2 %}
    {% set ordinal_suffix = 'nd' %}
  {% elseif last_one == 3 %}
    {% set ordinal_suffix = 'rd' %}
  {% else %}
    {% set ordinal_suffix = 'th' %}
  {% endif %}
  {% set district_text = district_num ~ ordinal_suffix ~ ' Senate District' %}
{% endif %}
{% include 'nys:senator-active-card' with {
  headshot: fields.field_member_headshot.content,
  name: fields.field_ol_sponsor.content,
  party: senator_parties|default([])|join(', '),
  district: district_text,
  count: fields.nid.content|render|striptags|trim,
  url: '/search/legislation?type=bill&sponsor=' ~ (fields.field_ol_sponsor_target_id.content|render|striptags|trim),
} only %}
