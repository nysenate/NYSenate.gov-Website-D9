<div class="carousel-item"
     role="group"
     aria-roledescription="slide"
     {% if slide_index is defined %}aria-label="{{ slide_index }} of {{ slide_total }}"{% endif %}>
  <div class="carousel-item__media">
    {%
      include '@nysenate_theme/media/media.twig' with {
        "image": image,
      } only
    %}
  </div>
</div>
