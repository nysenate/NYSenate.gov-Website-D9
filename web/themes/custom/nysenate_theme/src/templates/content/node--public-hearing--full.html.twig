{{ attach_library('nysenate_theme/session') }}
{{ attach_library('nysenate_theme/nysenate-issues') }}
{{ attach_library('nysenate_theme/meeting-detail') }}

{%
  set classes = [
  'node',
  'node--type-' ~ node.bundle|clean_class,
  not node.isPublished() ? 'node--unpublished',
  view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
  'c-block',
  'c-meeting-detail--header'
]
%}

{#
  The live video sits above the article both in the DOM and visually, so
  reading order already matches. The id is the target of the "Watch the live
  video" link next to the time (see video_status_link in preprocess).
#}
{% if video_status.key == 'streaming_live_now' %}
  <div class="c-meeting-detail--descript" id="hearing-live-video" tabindex="-1">
    {{ content.field_ustream }}
  </div>
{% elseif video_status.key == 'streaming_redirect' and content.field_video_redirect[0] %}
  <div class="c-meeting-detail--descript" id="hearing-live-video" tabindex="-1">
    {{ content.field_video_redirect  }}
  </div>
{% endif %}

<article{{ attributes.addClass(classes) }}>
  <div class="c-meeting-detail--meta">
    {% if video_status.key == "streaming_live_now" or video_status.key == "streaming_redirect" %}
      <p class="c-meeting-detail--live-flag">
        Streaming Live Now
      </p>
    {% endif %}

    {% if field_off_the_floor.key == '1' %}
      <p class="c-meeting-detail--live-flag">
        {{ field_off_the_floor.value }}
      </p>
    {% endif %}
  </div>

  <div class="c-meeting-detail--overview">
    {#
      The H1 comes first in the DOM so it is the first thing a screen reader
      reaches. The date follows it; CSS grid (c-meeting-detail--title-first,
      session.scss) still shows the date above the title on small screens and
      in the left column on wider ones.
    #}
    <div class="c-meeting-detail--info-container c-meeting-detail--title-first">
      <h1 class="c-meeting-detail--title">
        {{ title }}
      </h1>

      {#
        Plain spans, not <time>: VoiceOver in Safari read the date and the
        time twice when they were wrapped in <time>.
      #}
      <p class="c-meeting-detail--date">
        {% if date_value %}
          <span class="visually-hidden">{{ 'Date:'|t }} {{ date_value.date_full }}</span>
          <span class="c-meeting-date--num" aria-hidden="true">{{ date_value.day }}</span>
          <span class="c-meeting-date--month" aria-hidden="true">{{ date_value.month }}</span>
          <span class="c-meeting-date--year" aria-hidden="true">{{ date_value.year }}</span>
        {% endif %}
      </p>

      <div class="c-meeting-detail--info">
        {% set organization = content.field_location[0].organization['#value'] %}
        {% if location_url and organization %}
          <a class="c-meeting-detail--location-link"
            href="https://maps.google.com/?q={{ location_url }}"
            target="_blank"
            rel="noopener">
            <span class="visually-hidden">{{ 'Location:'|t }} </span>{{ organization }}<span class="visually-hidden"> {{ '(opens in a new tab)'|t }}</span>
          </a>
        {% endif %}
        <p class="c-meeting-detail--location">
          {% if not (location_url and organization) and (content.field_meeting_location[0] or location) %}
            <span class="visually-hidden">{{ 'Location:'|t }} </span>
          {% endif %}
          {% if content.field_meeting_location[0] %}
            {{ content.field_meeting_location[0] }}
          {% endif %}
          {% if location %}
            {{ location }}
          {% endif %}
        </p>
        <p class="c-meeting-detail--time">
          {% if date_value %}
            <span class="c-meeting-detail--time-range">
              <span class="visually-hidden">{{ 'Time:'|t }} </span>
              {{ date_value.start_time }}
              {% if date_value.start_time != date_value.end_time %}
                {{ 'to'|t }}
                {{ date_value.end_time }}
              {% endif %}
            </span>
          {% endif %}
          {% if video_status_link.text %}
            <span class="c-meeting-video--status">
              <span class="c-meeting-video--icon icon-before__youtube" aria-hidden="true"></span>
              {% if video_status_link.anchor %}
                <a href="#{{ video_status_link.anchor }}">{{ video_status_link.text }}</a>
              {% else %}
                {{ video_status_link.text }}
              {% endif %}
            </span>
          {% endif %}
        </p>

        {% if calendar_links %}
          {% include '@nysenate_theme/add-to-calendar/add-to-calendar.twig' with {
            calendar_links: calendar_links
          } only %}
        {% endif %}
      </div>
    </div>
  </div>

  <div class="c-meeting-detail--descript">
    {{ content.body }}
  </div>

  {% if content.field_chapters %}
    <div class="c-meeting-detail--descript">
      {{ content.field_chapters }}
    </div>
  {% endif %}

  {{ associated_topics_cache }}

  {% if related_issues %}
    <div class="c-meeting-detail--related">
      {% include '@nysenate_theme/associated-topics/associated-topics.twig' with {
        label: 'Related issues'|t,
        heading_level: 2,
        items: related_issues,
        item_prefix: 'Issue:'|t,
        modifier: 'issues',
      } only %}
    </div>
  {% endif %}

  {% if related_committees %}
    <div class="c-meeting-detail--related">
      {% include '@nysenate_theme/associated-topics/associated-topics.twig' with {
        label: 'Committees'|t,
        heading_level: 2,
        items: related_committees,
        item_prefix: 'Committee:'|t,
        modifier: 'committee',
      } only %}
    </div>
  {% endif %}

  {#
    Target of the "Watch the archived video" link. tabindex="-1" lets the
    link move focus here (Safari otherwise only scrolls), and the hidden
    heading makes the video reachable from the headings list.
  #}
  {% if content.field_yt[0] %}
    <div class="c-meeting-detail--descript c-meeting-detail--video" id="hearing-video" tabindex="-1">
      <h2 class="visually-hidden">{{ 'Hearing video'|t }}</h2>
      {{ content.field_yt }}
    </div>
  {% endif %}
</article>

{% if content.field_transcript.0 %}
  <div class="c-container--header__top-border transcript">
    <h2 class="c-container--title">{{ 'Transcript'|t }}</h2>
    <p>There is a full transcript of this meeting available.</p>
    <a href="{{ path('entity.node.canonical', {'node':  node.field_transcript.entity.id}) }}" class="c-container--link">Read Full Transcript</a>
  </div>
{% endif %}

{% if attachment_files %}
  {% include "@nysenate_theme/file-uploads/file-uploads.twig" with {
    heading: 'Testimony and documents'|t,
    heading_level: 2,
    files: attachment_files,
  } only %}
{% endif %}

{% include '@nysenate_theme/nysenate-social-buttons/nysenate-social-buttons.twig' with {
  title: node.type.entity.label,
  node_url: absolute_url,
  cta: cta
} only %}


